				"          poblacion_depto_estimada as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(municipio_id = trim(municipio_id),",
				"          zona_geografica = trim(zona_geografica),",
				"          departamento = regexReplace(trim(departamento), 'PotosÃ­', 'Potosí'),",
				"          es_capital_departamental = iif(es_capital_departamental == 'True', true(), false()),",
				"          poblacion_depto_estimada = toInteger(poblacion_depto_estimada),",
				"          codigo_departamento = trim(upper(codigo_departamento)),",
				"          municipio_nombre = regexReplace(regexReplace(regexReplace(regexReplace(\r",
				"  regexReplace(regexReplace(regexReplace(regexReplace(\r",
				"  regexReplace(regexReplace(regexReplace(regexReplace(\r",
				"    trim(municipio_nombre),\r",
				"  'YapacanÃ­','Yapacani'),\r",
				"  'San JuliÃ¡n','San Julián'),\r",
				"  'ConcepciÃ³n','Concepción'),\r",
				"  'RoborÃ©','Roboré'),\r",
				"  'ChimorÃ©','Chimoré'),\r",
				"  'PotosÃ­','Potosí'),\r",
				"  'VillazÃ³n','Villazón'),\r",
				"  'UncÃ­a','Uncía'),\r",
				"  'PoopÃ³','Poopó'),\r",
				"  'PazÃ±a','Pazña'),\r",
				"  'ZudÃ¡Ã±ez','Zudáñez'),\r",
				"  'YamparÃ¡ez','Yamparáez')) ~> Derivedcolumn",
				"Derivedcolumn select(mapColumn(",
				"          municipio_id,",
				"          municipio_nombre,",
				"          departamento,",
				"          codigo_departamento,",
				"          zona_geografica,",
				"          es_capital_departamental,",
				"          poblacion_depto_estimada",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          municipio_id as string,",
				"          municipio_nombre as string,",
				"          departamento as string,",
				"          codigo_departamento as string,",
				"          zona_geografica as string,",
				"          es_capital_departamental as boolean,",
				"          poblacion_depto_estimada as integer,",
				"          fecha_carga as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}