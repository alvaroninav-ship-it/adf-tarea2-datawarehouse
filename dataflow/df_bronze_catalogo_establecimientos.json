{
	"name": "df_bronze_catalogo_establecimientos",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "catalogo_establecimientos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          tipo_establecimiento as string,",
				"          nivel_atencion as string,",
				"          zona as string,",
				"          sedes as string,",
				"          red_salud as string,",
				"          departamento as string,",
				"          municipio as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          tiene_cadena_frio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(establecimiento_id = trim(establecimiento_id),",
				"          nombre_establecimiento = trim(nombre_establecimiento),",
				"          tipo_establecimiento = trim(tipo_establecimiento),",
				"          nivel_atencion = toInteger(nivel_atencion),",
				"          zona = trim(zona),",
				"          sedes = trim(sedes),",
				"          red_salud = trim(red_salud),",
				"          departamento = iif(trim(departamento) == 'PotosÃ­' || trim(departamento) == 'Potosí',\r",
				"    'Potosí',\r",
				"iif(trim(departamento) == 'ChuquisacÃ¡' || trim(departamento) == 'Chuquisacá',\r",
				"    'Chuquisaca',\r",
				"iif(trim(departamento) == 'OrurÃ³' || trim(departamento) == 'Oruro',\r",
				"    'Oruro',\r",
				"    trim(departamento)))),",
				"          municipio = initCap(trim(municipio)),",
				"          latitud = toDecimal(latitud, 10, 6),",
				"          longitud = toDecimal(longitud, 10, 6),",
				"          tiene_cadena_frio = iif(tiene_cadena_frio == 'True', true(), false()),",
				"          activo = iif(activo == 'True', true(), false())) ~> derivedColumn1"
			]
		}
	}
}