{
	"name": "df_vacunas_consolidadas",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "vacunacion_la_paz_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "vacunacion_rural_movil_csv",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "vacunacion_santa_cruz_csv",
						"type": "DatasetReference"
					},
					"name": "source3"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_vacunaciones_consolidadas",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				},
				{
					"name": "union2"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "select4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_registro as string,",
				"          cod_paciente as string,",
				"          documento_identidad as string,",
				"          nombres as string,",
				"          primer_apellido as string,",
				"          segundo_apellido as string,",
				"          genero as string,",
				"          fec_nacimiento as string,",
				"          municipio as string,",
				"          pueblo_indigena as string,",
				"          fec_vacunacion as string,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          nro_dosis as string,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          depto as string,",
				"          nro_lote as string,",
				"          temp_conservacion as string,",
				"          edad_dias as string,",
				"          via_aplicacion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          record_id as string,",
				"          sync_timestamp as string,",
				"          device_id as string,",
				"          patient_id as string,",
				"          patient_ci as string,",
				"          patient_name as string,",
				"          patient_last_name_1 as string,",
				"          patient_last_name_2 as string,",
				"          patient_sex as string,",
				"          patient_birth_date as string,",
				"          patient_department as string,",
				"          patient_municipality as string,",
				"          patient_community as string,",
				"          patient_indigenous as string,",
				"          vaccination_date as string,",
				"          vaccine_code as string,",
				"          vaccine_name as string,",
				"          dose_number as string,",
				"          facility_code as string,",
				"          facility_name as string,",
				"          lot_number as string,",
				"          storage_temp_celsius as string,",
				"          patient_age_days as string,",
				"          administration_route as string,",
				"          gps_latitude as string,",
				"          gps_longitude as string,",
				"          gps_accuracy_meters as string,",
				"          observations as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          registro_id as string,",
				"          paciente_id as string,",
				"          ci_paciente as string,",
				"          nombre_paciente as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          sexo as string,",
				"          fecha_nacimiento as string,",
				"          municipio_residencia as string,",
				"          comunidad_indigena as string,",
				"          fecha_vacunacion as string,",
				"          vacuna_id as string,",
				"          vacuna_nombre as string,",
				"          numero_dosis as string,",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          departamento as string,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as string,",
				"          edad_dias_aplicacion as string,",
				"          aplicacion_oportuna as string,",
				"          via_administracion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source1 derive(fec_vacunacion = iif(locate('/', fec_vacunacion) > 0,     toDate(fec_vacunacion, 'dd/MM/yyyy'),     toDate(fec_vacunacion, 'yyyy-MM-dd')),",
				"          fec_nacimiento = iif(locate('/', fec_nacimiento) > 0,     toDate(fec_nacimiento, 'dd/MM/yyyy'),     toDate(fec_nacimiento, 'yyyy-MM-dd')),",
				"          canal_origen = 'LPZ',",
				"          comunidad = toString(null()),",
				"          device_id = toString(null()),",
				"          sync_timestamp = toDate(null()),",
				"          observaciones = toString(null()),",
				"          aplicacion_oportuna_raw = toString(null()),",
				"          gps_latitud = toDecimal(null()),",
				"          gps_longitud = toDecimal(null()),",
				"          gps_precision_metros = toDecimal(null())) ~> derivedColumn1",
				"source2 derive(sync_timestamp = toDate(left(sync_timestamp, 10), 'yyyy-MM-dd'),",
				"          patient_birth_date = toDate(left(patient_birth_date, 10), 'yyyy-MM-dd'),",
				"          vaccination_date = toDate(left(vaccination_date, 10), 'yyyy-MM-dd'),",
				"          dose_number = toString(toInteger(toDouble(iifNull(dose_number, '0')))),",
				"          gps_latitude = toDecimal(gps_latitude, 10, 6),",
				"          gps_longitude = toDecimal(gps_longitude, 10, 6),",
				"          gps_accuracy_meters = toDecimal(gps_accuracy_meters, 7, 2),",
				"          canal_origen = 'MOVIL',",
				"          aplicacion_oportuna_raw = toString(null())) ~> derivedColumn2",
				"source3 derive(fecha_vacunacion = iif(left(fecha_vacunacion, 2) == '00',\r",
				"    toDate(null()),\r",
				"    toDate(fecha_vacunacion, 'dd/MM/yyyy')),",
				"          fecha_nacimiento = toDate(fecha_nacimiento, 'dd/MM/yyyy'),",
				"          canal_origen = 'SCZ',",
				"          device_id = toString(null()),",
				"          sync_timestamp = toDate(null()),",
				"          observaciones = toString(null()),",
				"          gps_latitud = toDecimal(null()),",
				"          gps_longitud = toDecimal(null()),",
				"          gps_precision_metros = toDecimal(null()),",
				"          comunidad = toString(null())) ~> derivedColumn3",
				"derivedColumn1 select(mapColumn(",
				"          id_registro_origen = id_registro,",
				"          paciente_id_origen = cod_paciente,",
				"          documento_identidad,",
				"          nombres,",
				"          primer_apellido,",
				"          segundo_apellido,",
				"          sexo_raw = genero,",
				"          fecha_nacimiento_raw = fec_nacimiento,",
				"          municipio,",
				"          pueblo_indigena_raw = pueblo_indigena,",
				"          fecha_vacunacion_raw = fec_vacunacion,",
				"          cod_vacuna,",
				"          desc_vacuna,",
				"          numero_dosis_raw = nro_dosis,",
				"          cod_establecimiento,",
				"          desc_establecimiento,",
				"          departamento_raw = depto,",
				"          numero_lote = nro_lote,",
				"          temperatura_conservacion = temp_conservacion,",
				"          edad_dias_aplicacion = edad_dias,",
				"          via_administracion_raw = via_aplicacion,",
				"          canal_origen,",
				"          comunidad,",
				"          device_id,",
				"          sync_timestamp,",
				"          observaciones,",
				"          aplicacion_oportuna_raw,",
				"          gps_latitud,",
				"          gps_longitud,",
				"          gps_precision_metros",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn2 select(mapColumn(",
				"          id_registro_origen = record_id,",
				"          sync_timestamp,",
				"          device_id,",
				"          paciente_id_origen = patient_id,",
				"          documento_identidad = patient_ci,",
				"          nombres = patient_name,",
				"          primer_apellido = patient_last_name_1,",
				"          segundo_apellido = patient_last_name_2,",
				"          sexo_raw = patient_sex,",
				"          fecha_nacimiento_raw = patient_birth_date,",
				"          departamento_raw = patient_department,",
				"          municipio = patient_municipality,",
				"          comunidad = patient_community,",
				"          pueblo_indigena_raw = patient_indigenous,",
				"          fecha_vacunacion_raw = vaccination_date,",
				"          cod_vacuna = vaccine_code,",
				"          desc_vacuna = vaccine_name,",
				"          numero_dosis_raw = dose_number,",
				"          cod_establecimiento = facility_code,",
				"          desc_establecimiento = facility_name,",
				"          numero_lote = lot_number,",
				"          temperatura_conservacion = storage_temp_celsius,",
				"          edad_dias_aplicacion = patient_age_days,",
				"          via_administracion_raw = administration_route,",
				"          gps_latitud = gps_latitude,",
				"          gps_longitud = gps_longitude,",
				"          gps_precision_metros = gps_accuracy_meters,",
				"          observaciones = observations,",
				"          canal_origen,",
				"          aplicacion_oportuna_raw",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn3 select(mapColumn(",
				"          id_registro_origen = registro_id,",
				"          paciente_id_origen = paciente_id,",
				"          documento_identidad = ci_paciente,",
				"          nombres = nombre_paciente,",
				"          primer_apellido = apellido_paterno,",
				"          segundo_apellido = apellido_materno,",
				"          sexo_raw = sexo,",
				"          fecha_nacimiento_raw = fecha_nacimiento,",
				"          municipio = municipio_residencia,",
				"          pueblo_indigena_raw = comunidad_indigena,",
				"          fecha_vacunacion_raw = fecha_vacunacion,",
				"          cod_vacuna = vacuna_id,",
				"          desc_vacuna = vacuna_nombre,",
				"          numero_dosis_raw = numero_dosis,",
				"          cod_establecimiento = establecimiento_id,",
				"          desc_establecimiento = nombre_establecimiento,",
				"          departamento_raw = departamento,",
				"          numero_lote = lote_vacuna,",
				"          temperatura_conservacion,",
				"          edad_dias_aplicacion,",
				"          aplicacion_oportuna_raw = aplicacion_oportuna,",
				"          via_administracion_raw = via_administracion,",
				"          canal_origen,",
				"          device_id,",
				"          sync_timestamp,",
				"          observaciones,",
				"          gps_latitud,",
				"          gps_longitud,",
				"          gps_precision_metros,",
				"          comunidad",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, select2 union(byName: true)~> union1",
				"union1, select3 union(byName: true)~> union2",
				"union2 derive(sexo_raw = iif(upper(trim(sexo_raw)) == 'M'\r",
				"    || upper(trim(sexo_raw)) == 'MASCULINO', 'Masculino',\r",
				"iif(upper(trim(sexo_raw)) == 'F'\r",
				"    || upper(trim(sexo_raw)) == 'FEMENINO', 'Femenino',\r",
				"    'Desconocido')),",
				"          pueblo_indigena_raw = iif(upper(trim(pueblo_indigena_raw)) == 'SÍ'\r",
				"    || upper(trim(pueblo_indigena_raw)) == 'SI'\r",
				"    || upper(trim(pueblo_indigena_raw)) == 'TRUE', true(), false()),",
				"          aplicacion_oportuna_raw = iif(upper(trim(aplicacion_oportuna_raw)) == 'TRUE', true(), false()),",
				"          numero_dosis_raw = toInteger(iifNull(numero_dosis_raw, '0')),",
				"          departamento_raw = iif(lower(trim(regexReplace(departamento_raw, '\\\\s+', ' '))) == 'la paz'\r",
				"    || lower(trim(departamento_raw)) == 'l.p.'\r",
				"    || lower(trim(departamento_raw)) == 'depto. la paz'\r",
				"    || lower(trim(departamento_raw)) == 'lapaz',\r",
				"    'La Paz',\r",
				"iif(lower(trim(regexReplace(departamento_raw, '\\\\s+', ' '))) == 'santa cruz'\r",
				"    || lower(trim(departamento_raw)) == 'sta cruz'\r",
				"    || lower(trim(departamento_raw)) == 'sta. cruz'\r",
				"    || lower(trim(departamento_raw)) == 'sta cruz de la sierra'\r",
				"    || lower(trim(departamento_raw)) == 'santacruz',\r",
				"    'Santa Cruz',\r",
				"    initCap(trim(departamento_raw)))),",
				"          municipio = initCap(trim(regexReplace(municipio, '\\\\s+', ' '))),",
				"          via_administracion_raw = iif(upper(trim(via_administracion_raw)) == 'INTRAMUSCULAR', 'Intramuscular',\r",
				"iif(upper(trim(via_administracion_raw)) == 'ORAL', 'Oral',\r",
				"iif(upper(trim(via_administracion_raw)) == 'SUBCUTÁNEA'\r",
				"    || upper(trim(via_administracion_raw)) == 'SUBCUTANEA', 'Subcutánea',\r",
				"iif(upper(trim(via_administracion_raw)) == 'INTRADÉRMICA'\r",
				"    || upper(trim(via_administracion_raw)) == 'INTRADERMICA', 'Intradérmica',\r",
				"    trim(via_administracion_raw))))),",
				"          documento_identidad = iifNull(documento_identidad, 'SIN_CI'),",
				"          paciente_id_origen = iifNull(paciente_id_origen, 'SIN_ID'),",
				"          comunidad = iifNull(comunidad, 'Sin comunidad'),",
				"          observaciones = iifNull(observaciones, ''),",
				"          temperatura_conservacion = toDecimal(temperatura_conservacion, 5, 2),",
				"          edad_dias_aplicacion = toInteger(edad_dias_aplicacion)) ~> derivedColumn4",
				"derivedColumn4 select(mapColumn(",
				"          id_registro_origen,",
				"          paciente_id_origen,",
				"          documento_identidad,",
				"          nombres,",
				"          primer_apellido,",
				"          segundo_apellido,",
				"          sexo_raw,",
				"          fecha_nacimiento_raw,",
				"          municipio_residencia = municipio,",
				"          pueblo_indigena_raw,",
				"          fecha_vacunacion_raw,",
				"          cod_vacuna,",
				"          desc_vacuna,",
				"          numero_dosis_raw,",
				"          cod_establecimiento,",
				"          desc_establecimiento,",
				"          departamento_raw,",
				"          numero_lote,",
				"          temperatura_conservacion,",
				"          edad_dias_aplicacion,",
				"          via_administracion_raw,",
				"          canal_origen,",
				"          comunidad,",
				"          device_id,",
				"          sync_timestamp,",
				"          observaciones,",
				"          aplicacion_oportuna_raw,",
				"          gps_latitud,",
				"          gps_longitud,",
				"          gps_precision_metros",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_registro_origen as string,",
				"          canal_origen as string,",
				"          paciente_id_origen as string,",
				"          documento_identidad as string,",
				"          nombres as string,",
				"          primer_apellido as string,",
				"          segundo_apellido as string,",
				"          sexo as string,",
				"          fecha_nacimiento as date,",
				"          municipio_residencia as string,",
				"          departamento_residencia as string,",
				"          pueblo_indigena as boolean,",
				"          comunidad as string,",
				"          fecha_vacunacion as date,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          numero_dosis as integer,",
				"          edad_dias_aplicacion as integer,",
				"          temperatura_conservacion as decimal(5,2),",
				"          numero_lote as string,",
				"          via_administracion as string,",
				"          aplicacion_oportuna as boolean,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          departamento_establecimiento as string,",
				"          device_id as string,",
				"          sync_timestamp as timestamp,",
				"          gps_latitud as decimal(10,6),",
				"          gps_longitud as decimal(10,6),",
				"          gps_precision_metros as decimal(7,2),",
				"          observaciones as string,",
				"          fecha_carga as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_registro_origen,",
				"          canal_origen,",
				"          paciente_id_origen,",
				"          documento_identidad,",
				"          nombres,",
				"          primer_apellido,",
				"          segundo_apellido,",
				"          sexo = sexo_raw,",
				"          fecha_nacimiento = fecha_nacimiento_raw,",
				"          municipio_residencia,",
				"          departamento_residencia = departamento_raw,",
				"          pueblo_indigena = pueblo_indigena_raw,",
				"          comunidad,",
				"          fecha_vacunacion = fecha_vacunacion_raw,",
				"          cod_vacuna,",
				"          desc_vacuna,",
				"          numero_dosis = numero_dosis_raw,",
				"          edad_dias_aplicacion,",
				"          temperatura_conservacion,",
				"          numero_lote,",
				"          via_administracion = via_administracion_raw,",
				"          aplicacion_oportuna = aplicacion_oportuna_raw,",
				"          cod_establecimiento,",
				"          desc_establecimiento,",
				"          device_id,",
				"          sync_timestamp,",
				"          gps_latitud,",
				"          gps_longitud,",
				"          gps_precision_metros,",
				"          observaciones",
				"     )) ~> sink1"
			]
		}
	}
}